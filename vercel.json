{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/blog/blog.amp", "destination": "/blog/amp/", "permanent": true },
    { "source": "/blog/blog.amp.html", "destination": "/blog/amp/", "permanent": true },
    { "source": "/**/*.html", "destination": "/:path*/", "permanent": true },
    { "source": "/**/index.html", "destination": "/:path*/", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
