{
  "rules": {
    "chat": {
      "$room": {
        ".read": true,
        ".indexOn": [
          "ts"
        ],
        "$msg": {
          ".write": "auth != null && ((!data.exists() && newData.child('u').val() === auth.uid) || (data.exists() && data.child('u').val() === auth.uid && newData.child('u').val() === auth.uid))",
          ".validate": "newData.hasChildren(['n','ts'])",
          "n": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
          },
          "u": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
          },
          "k": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "a": {
            ".validate": "newData.isNumber() || newData.isString()"
          },
          "c": {
            ".validate": "newData.isNumber() || newData.isString()"
          },
          "t": {
            ".validate": "newData.isString() && newData.val().length <= 2000"
          },
          "img": {
            ".validate": "newData.isString() && newData.val().length < 1500000"
          },
          "w": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "h": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "ts": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= (now + 30000)"
          },
          "ed": {
            ".validate": "newData.val() === 1"
          },
          "edt": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "rt": {
            ".validate": "newData.hasChildren(['n'])",
            "n": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "t": {
              ".validate": "newData.isString() && newData.val().length <= 2000"
            },
            "img": {
              ".validate": "newData.isString() && newData.val().length < 1500000"
            }
          },
          "r": {
            ".write": "auth != null",
            "$rx": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
            }
          },
          "ra": {
            "$rx": {
              "$actor": {
                ".write": "auth != null && auth.uid === $actor",
                ".validate": "newData.val() === true"
              }
            }
          }
        }
      }
    },
    "presence": {
      "$room": {
        "$tab": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() ? newData.child('u').val() === auth.uid : (data.child('u').val() === auth.uid || newData.child('u').val() === auth.uid))",
          ".validate": "newData.hasChildren(['n','t','u'])",
          "n": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
          },
          "u": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
          },
          "a": {
            ".validate": "newData.isNumber() || newData.isString()"
          },
          "c": {
            ".validate": "newData.isNumber() || newData.isString()"
          },
          "s": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= (now + 60000)"
          }
        }
      }
    },
    "typing": {
      "$room": {
        "$tab": {
          ".read": "auth != null",
          ".write": "auth != null && newData.child('u').val() === auth.uid",
          ".validate": "newData.hasChildren(['t'])",
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "u": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= (now + 30000)"
          }
        }
      }
    },
    "rate": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['ts'])",
        "ts": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= (now + 30000) && (!data.exists() || newData.val() >= data.val() + 400)"
        }
      }
    },
    "block": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$other": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === true"
        }
      }
    },
    "forum": {
      ".read": false,
      ".write": false,
      "staff": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      },
      "$site": {
        ".read": "auth != null",
        "$other": {
          ".write": false,
          ".validate": false
        },
        "counts": {
          ".read": true,
          "$topicId": {
            ".write": "auth != null && newData.isNumber() && ((!data.exists() && (newData.val() === 0 || newData.val() === 1)) || newData.val() === (data.exists() ? data.val() : 0) + 1 || newData.val() === (data.exists() ? data.val() : 0) - 1)",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          }
        },
        "access": {
          "$topicId": {
            ".read": "auth != null",
            ".write": "root.child('forum').child('staff').child(auth.uid).exists()",
            ".validate": "!newData.exists() || newData.hasChildren(['t', 'ts'])",
            "r": {
              "$rid": {
                ".write": "auth != null && (((!data.exists() || data.child('u').val() === auth.uid) && newData.child('u').val() === auth.uid) || root.child('forum').child('staff').child(auth.uid).exists())",
                ".validate": "newData.hasChildren(['t', 'u', 'n', 'ts']) && newData.child('t').isString() && newData.child('t').val().length >= 2 && newData.child('t').val().length <= 1200 && newData.child('n').isString() && newData.child('n').val().length <= 24 && newData.child('ts').isNumber() && (!newData.child('u').isString() || newData.child('u').val().length <= 128)"
              }
            }
          }
        },
        "tech": {
          "$topicId": {
            ".read": "auth != null",
            ".write": "root.child('forum').child('staff').child(auth.uid).exists()",
            ".validate": "!newData.exists() || newData.hasChildren(['t', 'ts'])",
            "r": {
              "$rid": {
                ".write": "auth != null && (((!data.exists() || data.child('u').val() === auth.uid) && newData.child('u').val() === auth.uid) || root.child('forum').child('staff').child(auth.uid).exists())",
                ".validate": "newData.hasChildren(['t', 'u', 'n', 'ts']) && newData.child('t').isString() && newData.child('t').val().length >= 2 && newData.child('t').val().length <= 1200 && newData.child('n').isString() && newData.child('n').val().length <= 24 && newData.child('ts').isNumber() && (!newData.child('u').isString() || newData.child('u').val().length <= 128)"
              }
            }
          }
        },
        "ban": {
          "$topicId": {
            ".read": "auth != null",
            ".write": "root.child('forum').child('staff').child(auth.uid).exists()",
            ".validate": "!newData.exists() || newData.hasChildren(['t', 'ts'])",
            "r": {
              "$rid": {
                ".write": "auth != null && (((!data.exists() || data.child('u').val() === auth.uid) && newData.child('u').val() === auth.uid) || root.child('forum').child('staff').child(auth.uid).exists())",
                ".validate": "newData.hasChildren(['t', 'u', 'n', 'ts']) && newData.child('t').isString() && newData.child('t').val().length >= 2 && newData.child('t').val().length <= 1200 && newData.child('n').isString() && newData.child('n').val().length <= 24 && newData.child('ts').isNumber() && (!newData.child('u').isString() || newData.child('u').val().length <= 128)"
              }
            }
          }
        },
        "ideas": {
          "$topicId": {
            ".read": "auth != null",
            ".write": "root.child('forum').child('staff').child(auth.uid).exists()",
            ".validate": "!newData.exists() || newData.hasChildren(['t', 'ts'])",
            "r": {
              "$rid": {
                ".write": "auth != null && (((!data.exists() || data.child('u').val() === auth.uid) && newData.child('u').val() === auth.uid) || root.child('forum').child('staff').child(auth.uid).exists())",
                ".validate": "newData.hasChildren(['t', 'u', 'n', 'ts']) && newData.child('t').isString() && newData.child('t').val().length >= 2 && newData.child('t').val().length <= 1200 && newData.child('n').isString() && newData.child('n').val().length <= 24 && newData.child('ts').isNumber() && (!newData.child('u').isString() || newData.child('u').val().length <= 128)"
              }
            }
          }
        },
        "general": {
          "$topicId": {
            ".read": "auth != null",
            ".write": "root.child('forum').child('staff').child(auth.uid).exists()",
            ".validate": "!newData.exists() || newData.hasChildren(['t', 'ts'])",
            "r": {
              "$rid": {
                ".write": "auth != null && (((!data.exists() || data.child('u').val() === auth.uid) && newData.child('u').val() === auth.uid) || root.child('forum').child('staff').child(auth.uid).exists())",
                ".validate": "newData.hasChildren(['t', 'u', 'n', 'ts']) && newData.child('t').isString() && newData.child('t').val().length >= 2 && newData.child('t').val().length <= 1200 && newData.child('n').isString() && newData.child('n').val().length <= 24 && newData.child('ts').isNumber() && (!newData.child('u').isString() || newData.child('u').val().length <= 128)"
              }
            }
          }
        },
        "votes": {
          "$topicId": {
            ".read": "auth != null",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && (newData.val() === true || !newData.exists())",
              ".validate": "!newData.exists() || newData.val() === true"
            }
          }
        },
        "read": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            "$topicId": {
              ".validate": "newData.isNumber()"
            }
          }
        },
        "reports": {
          ".read": "auth != null && root.child('forum').child('staff').child(auth.uid).exists()",
          ".write": "auth != null && (!data.exists() || data.child('u').val() === auth.uid)",
          ".validate": "newData.hasChildren(['t', 'u', 'ts'])",
          "$rid": {
            ".validate": "newData.child('ts').isNumber() && (!newData.child('why').isString() || newData.child('why').val().length <= 200)"
          }
        },
        "pending": {
          ".read": "auth != null && root.child('forum').child('staff').child(auth.uid).exists()",
          "$pid": {
            ".write": "auth != null && ((!data.exists() && newData.child('state').val() === 'pending' && newData.child('k').isString() && newData.child('k').val().length > 0 && root.child('forum').child($site).child('rate').child(auth.uid).child(newData.child('k').val()).exists()) || (data.exists() && root.child('forum').child('staff').child(auth.uid).exists()))",
            ".validate": "newData.child('k').isString() && newData.child('t').isString() && newData.child('t').val().length >= 8 && newData.child('t').val().length <= 140 && newData.child('b').isString() && newData.child('b').val().length >= 15 && newData.child('b').val().length <= 2000 && newData.child('cat').isString() && newData.child('ts').isNumber() || root.child('forum').child('staff').child(auth.uid).exists()"
          }
        },
        "rate": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber() && newData.val() > 0",
            "$window": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.isNumber()",
              ".validate": "newData.isNumber() && newData.val() > 0"
            }
          }
        }
      }
    }
  }
}
